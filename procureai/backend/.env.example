# ==============================================================================
# ProcureAI Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in production if custom configuration is required.
# Do NOT commit actual production secrets or certificates to version control.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated):
# - In a same-origin reverse-proxy deployment (e.g. Nginx proxying /api), CORS is
#   bypassed because requests originate from the same host.
# - In a cross-origin / split deployment (e.g. frontend on Vercel or separate domain),
#   specify the authorized frontend origin(s) here:
# Example: ALLOWED_ORIGINS=https://procureai.example.com,https://staging.procureai.example.com
# If unset, defaults to local development origins (http://localhost:5173, http://127.0.0.1:5173, etc.)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dataset File Location:
# Defaults to procurement_scored.csv located in the backend directory.
# Only override if mounting or storing the dataset in a custom directory.
# DATA_PATH=/path/to/procurement_scored.csv

# ==============================================================================
# Live Surveillance & External Data Ingestion Configuration (RT-9)
# ==============================================================================
# Active live data source mode: 'mock' (default deterministic feed) or 'ogd_india'
PROCUREAI_LIVE_SOURCE=ogd_india

# Open Government Data (OGD) Platform India (data.gov.in) API Credentials:
# Register for a free API key at https://data.gov.in/
DATA_GOV_IN_API_KEY=

# Target Government Procurement Dataset Resource ID on data.gov.in:
# Example Resource ID format: 579b464d-b66e-c23b-dd00-0001cdd3946e
DATA_GOV_IN_RESOURCE_ID=

# Base URL for OGD Platform API (Default: https://api.data.gov.in/resource)
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource
