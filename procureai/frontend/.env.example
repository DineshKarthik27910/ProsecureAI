# ==============================================================================
# ProcureAI Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.production for production builds if needed.
# Do NOT commit actual .env files containing sensitive values to version control.
# ==============================================================================

# VITE_API_BASE_URL:
# The base URL of the ProcureAI FastAPI backend.
#
# SCENARIO 1: Same-Origin Reverse-Proxy Deployment (RECOMMENDED)
# When deploying behind Nginx or Cloudflare where Nginx proxies /api to the FastAPI
# backend, leave VITE_API_BASE_URL empty. The browser makes same-origin requests
# to /api, which eliminates CORS issues entirely.
VITE_API_BASE_URL=

# SCENARIO 2: Split / Cross-Origin Deployment
# When frontend is hosted separately from the backend (e.g. Vercel, Netlify, S3)
# and the FastAPI backend is hosted on Cloud Run, Render, or a separate domain:
# Uncomment and set the full URL to the backend (without trailing slash):
# VITE_API_BASE_URL=https://api.procureai.example.com
